{
  "repository": "https://github.com/anosu/girlscreation-translation.git",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node app.ts",
    "workflow": "uv run --no-sync python -m scripts.run",
    "lint": "uv run --no-sync ruff check scripts tests && uv run --no-sync ruff format --check scripts tests",
    "format": "uv run --no-sync ruff format scripts tests",
    "typecheck": "npm run typecheck:python && npm run typecheck:typescript",
    "typecheck:python": "uv run --no-sync pyright",
    "typecheck:typescript": "tsc --noEmit",
    "prepare": "husky",
    "build:manifest": "uv run --no-sync python -m scripts.build",
    "check:translations": "uv run --no-sync python -m scripts.run check",
    "test": "uv run --no-sync python -m unittest discover -s tests -v && node --test tests/server.test.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.154.0",
    "@types/node": "^22.20.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4"
  }
}
